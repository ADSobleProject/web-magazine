# 환경 변수 예시. 실제 값은 저장소에 올리지 말고 Render의 Environment(운영) 또는 셸 환경 변수(로컬)에 넣는다.
# 로컬 개발은 아무것도 넣지 않아도 된다: DB는 data/pglite, 업로드는 uploads/ 폴더를 쓴다.

# 정식 주소
SITE_ORIGIN=https://web-magazine.onrender.com

# Neon Postgres 접속 주소 (Neon 대시보드 → Connect → 연결 문자열, 끝에 ?sslmode=require 포함)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Cloudinary 접속 정보 (Cloudinary 대시보드 → API Keys의 API environment variable)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# 첫 관리자 만들기 화면(/admin/setup)용 일회용 코드. 16자 이상의 임의 문자열.
ADMIN_SETUP_TOKEN=
